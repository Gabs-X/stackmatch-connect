# Environment variables StackMatch reads. None is needed to run the app locally: without
# DATABASE_URL, the dev server uses PGlite in .pglite/.
#
# Don't put DATABASE_URL in .env or .env.local: the dev server loads those files and would use
# that database. For `npm run db:migrate`, copy this file to .env.migrate.local (ignored by git)
# and fill in only DATABASE_URL. See docs/deploy-neon.md.

# Neon direct connection (no "-pooler" in the host), for migrations.
DATABASE_URL=

# Set in the Vercel project settings, not in a local file:
# DATABASE_URL                 created by the Neon integration
# VITE_DEMO_ACCOUNTS=false     removes the test accounts teste.dev / teste.emp
# VITE_VERCEL_ANALYTICS=true   turns on Vercel Analytics
# VITE_ASSISTANT_API_URL=      assistant backend; empty keeps the simulated replies
