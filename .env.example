# Vercel Web Analytics
# Enable Vercel Web Analytics tracking when hosted on Vercel
# Set to "true" to enable analytics collection
# Note: Analytics only works when deployed to Vercel hosting
VITE_VERCEL_ANALYTICS=false

# Assistant API (Optional)
# URL for the AI assistant backend service
# Leave undefined to use simulated responses
# VITE_ASSISTANT_API_URL=https://api.example.com/assistant
