# Environment variables StackMatch reads. None is needed to run the app locally: without
# DATABASE_URL, the dev server uses PGlite in .pglite/.
#
# Don't put DATABASE_URL in .env or .env.local: the dev server loads those files and would use
# that database. For `npm run db:migrate` and `npm run db:seed`, copy this file to
# .env.migrate.local (ignored by git) and fill in only DATABASE_URL. See docs/deploy-neon.md.

# Neon direct connection (no "-pooler" in the host), for migrations and the seed.
DATABASE_URL=

# Vercel Blob token, only for `npm run images:migrate`. Without it, the app keeps images in
# .uploads/ (development and tests only).
BLOB_READ_WRITE_TOKEN=

# Set in the Vercel project settings, not in a local file:
# DATABASE_URL                 created by the Neon integration
# BLOB_READ_WRITE_TOKEN        created by the Blob store integration
# RESEND_API_KEY               sends the e-mail codes; without it they go to the server log
#                              (development only)
# EMAIL_FROM                   sender, from a domain verified on Resend
# SUPPORT_EMAIL                where support tickets arrive and where replies to the
#                              e-mail-changed notice go; without it, tickets stay only in the database
# DEEPL_API_KEY               translates profile texts (DeepL API Free keys end in ":fx")
# TRANSLATION_BACKUP=claude    optional; Claude (ANTHROPIC_API_KEY) translates when DeepL fails
# ADMIN_EMAILS                comma-separated e-mails of the accounts that can open
#                              /admin/tickets (they must be confirmed accounts)
# CRON_SECRET                  protects the daily cleanup that Vercel Cron calls
# VITE_VERCEL_ANALYTICS=true   turns on Vercel Analytics
# ANTHROPIC_API_KEY            Claude API key for the support assistant (/api/assistant)
# ASSISTANT_MONTHLY_BUDGET_USD monthly spending cap for the assistant, in US$ (default 20);
#                              past it, Ada pauses until the next month
# VITE_ASSISTANT_API_URL=/api/assistant
#                              turns the assistant on; empty keeps the simulated replies
